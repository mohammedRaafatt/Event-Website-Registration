FROM nginx:1.27-alpine

# Base image ships index.html ("Welcome to nginx!"). COPY merges and can leave it. Clear, then copy app
# (frontend/index.html redirects to pages/ so / always hits your UI).
RUN rm -rf /usr/share/nginx/html/*
COPY frontend/ /usr/share/nginx/html/
COPY docker/nginx-frontend.conf /etc/nginx/conf.d/default.conf
COPY docker/docker-frontend-entrypoint.sh /docker-frontend-entrypoint.sh
RUN chmod +x /docker-frontend-entrypoint.sh

EXPOSE 80

ENTRYPOINT ["/docker-frontend-entrypoint.sh"]
CMD ["nginx", "-g", "daemon off;"]
