# Copy this file to config/.env and fill in your values.
# Do NOT commit config/.env to git — it is in .gitignore.

PORT=5001
JWT_SECRET=replace_with_a_long_random_secret_string

# PostgreSQL configuration:
# You can use a full connection string (recommended for Aiven):
DATABASE_URL=postgres://user:password@host:port/dbname?sslmode=require

# Or individual variables:
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_NAME=eventdb
DB_SSL=true

# --- Docker Compose (optional; set in shell or a root .env file next to docker-compose.yml) ---
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=eventdb
# JWT_SECRET=replace_with_a_long_random_secret_string
# Browser-visible API root (no trailing slash after /api). Default matches API_PUBLISH_PORT=5001:
# API_BASE=http://localhost:5001/api
# POSTGRES_PUBLISH_PORT=5432
# API_PUBLISH_PORT=5001
# FRONTEND_PUBLISH_PORT=8080
